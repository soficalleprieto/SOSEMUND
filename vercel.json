{
  "$schema": "https://openapi.vercel.sh/vercel.json",
  "redirects": [
    { "source": "/censo", "destination": "/colombia/terremoto-2026/censo", "permanent": true },
    { "source": "/ayudas", "destination": "/colombia/terremoto-2026", "permanent": true },
    { "source": "/ayudas/:ciudad", "destination": "/colombia/terremoto-2026/:ciudad", "permanent": true },
    { "source": "/:pais/:evento/negocios/anadir", "destination": "/:pais/:evento/negocios/alta", "permanent": true }
  ],
  "headers": [
    {
      "source": "/(.*)",
      "headers": [
        { "key": "X-Content-Type-Options", "value": "nosniff" },
        { "key": "X-Frame-Options", "value": "SAMEORIGIN" },
        { "key": "Referrer-Policy", "value": "strict-origin-when-cross-origin" }
      ]
    }
  ]
}
