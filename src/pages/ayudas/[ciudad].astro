---
import Base from "../../layouts/Base.astro";
import CompartirWhatsApp from "../../components/CompartirWhatsApp.astro";
import Fuentes from "../../components/Fuentes.astro";
import { CIUDADES, type Ciudad } from "../../data/datos";
import { AYUDAS_NACIONALES } from "../../data/ayudas";

// Una plantilla, cinco páginas. Cuando haya que desglosar banco por banco,
// sigue siendo esta misma plantilla.
export function getStaticPaths() {
  return CIUDADES.map((ciudad) => ({
    params: { ciudad: ciudad.slug },
    props: { ciudad },
  }));
}

interface Props {
  ciudad: Ciudad;
}

const { ciudad: c } = Astro.props;
const otras = CIUDADES.filter((o) => o.slug !== c.slug);
---

<Base
  titulo={`Ayudas para negocios afectados por el terremoto en ${c.nombre}`}
  descripcion={`Qué puede pedir un comerciante de ${c.nombre} tras el terremoto: cómo censarse, alivios bancarios, alivios tributarios y líneas de crédito. Con fuente y fecha.`}
  ruta={`/ayudas/${c.slug}`}
>
  <h1>Ayudas para negocios en {c.nombre}</h1>
  <p class="meta">
    {c.departamento}{c.alertaRoja && " · Estuvo en alerta roja tras el sismo"}
  </p>
  {c.contexto && <p>{c.contexto}</p>}

  {/* El censo va primero en todas las páginas: es lo que desbloquea el resto. */}
  <section class="caja caja-acento">
    <h2 style="margin-top:0">Primero: cénsate</h2>
    <p>{c.censoNegocios.detalle}</p>
    {
      c.censoNegocios.telefonos && (
        <p>
          <strong>Líneas de atención: </strong>
          {c.censoNegocios.telefonos.map((t, i) => (
            <>
              {i > 0 && " · "}
              <a class="telefono" href={`tel:${t.replace(/\s/g, "")}`}>
                {t}
              </a>
            </>
          ))}
        </p>
      )
    }
    <p>
      <a href="/censo"><strong>Ver el paso a paso completo del censo →</strong></a>
    </p>
  </section>

  <h2>Qué puedes pedir</h2>
  {
    AYUDAS_NACIONALES.map((a) => (
      <section class="caja">
        <h3>{a.titulo}</h3>
        <p>
          <strong>{a.resumen}</strong>
        </p>
        <p>{a.detalle}</p>
        {a.pendiente && (
          <p class="caja-pendiente">
            <strong>En verificación.</strong> {a.pendiente}
          </p>
        )}
        <Fuentes fuentes={a.fuentes} />
      </section>
    ))
  }

  <h2>Otras ciudades</h2>
  <ul class="enlaces-ciudades">
    {otras.map((o) => (
      <li>
        <a href={`/ayudas/${o.slug}`}>{o.nombre}</a>
      </li>
    ))}
  </ul>

  <CompartirWhatsApp
    ruta={`/ayudas/${c.slug}`}
    texto={`Ayudas para negocios afectados por el terremoto en ${c.nombre}: cómo censarte y qué puedes pedir.`}
  />
</Base>
