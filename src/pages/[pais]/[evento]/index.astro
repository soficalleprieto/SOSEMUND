---
import Base from "../../../layouts/Base.astro";
import Breadcrumbs from "../../../components/Breadcrumbs.astro";
import CompartirWhatsApp from "../../../components/CompartirWhatsApp.astro";
import Fuentes from "../../../components/Fuentes.astro";
import Imagen from "../../../components/Imagen.astro";
import { todosLosEventos } from "../../../data/paises";
import { IMG_MAPA } from "../../../data/imagenes";
import type { Evento, Pais } from "../../../data/tipos";
import { formatearFecha } from "../../../utils/fecha";
import { enlaceWhatsApp } from "../../../data/contacto";

export function getStaticPaths() {
  return todosLosEventos().map(({ pais, evento }) => ({
    params: { pais: pais.slug, evento: evento.slug },
    props: { pais, evento },
  }));
}

interface Props {
  pais: Pais;
  evento: Evento;
}
const { pais, evento } = Astro.props;
const base = `/${pais.slug}/${evento.slug}`;
const n = (x: number) => x.toLocaleString("es-CO");
---

<Base
  titulo={`Ayudas para negocios tras ${evento.nombre} en ${pais.nombre}`}
  descripcion={`Guía para comerciantes afectados por ${evento.nombre} en ${pais.nombre}: cómo censar tu negocio, qué alivios existen y cómo pedirlos.`}
  ruta={base}
>
  <Breadcrumbs
    items={[
      { nombre: "Inicio", href: "/" },
      { nombre: pais.nombre, href: `/${pais.slug}` },
      { nombre: evento.nombreCorto },
    ]}
  />

  <h1>Tu negocio no tiene que cerrar</h1>
  <p class="entradilla">
    Guía para comerciantes afectados por {evento.nombre} en {pais.nombre}. Qué
    tienes que hacer primero, qué alivios existen y cómo pedirlos, sin letra
    pequeña.
  </p>

  <h2>Busca por tu localidad</h2>
  <ul class="localidades">
    {
      [...evento.localidades]
        .sort((a, b) => a.nombre.localeCompare(b.nombre, "es"))
        .map((c) => (
          <li>
            <a href={`${base}/${c.slug}`}>
              {c.nombre}
              <span class="depto">{c.division}</span>
            </a>
          </li>
        ))
    }
  </ul>
  {
    evento.impacto.municipiosAfectados &&
      evento.localidades.length < evento.impacto.municipiosAfectados && (
        <p class="meta">
          Cubrimos {evento.localidades.length} de los{" "}
          {evento.impacto.municipiosAfectados} municipios afectados — los que
          tienen canal de censo verificado.{" "}
          <a
            href={enlaceWhatsApp(
              `Hola. Mi municipio no está en el listado de S.O.S.EMUND para ${evento.nombreCorto}, pero tengo información sobre cómo censar negocios afectados ahí. Esto es lo que sé:`,
            )}
            target="_blank"
            rel="noopener"
          >
            ¿No está el tuyo, pero tienes información útil?
          </a>
        </p>
      )
  }

  <div class="dos-cta">
    <a class="cta" href={`${base}/censo`}>
      <span class="cta-eyebrow">Empieza por aquí</span>
      <span class="cta-titulo">Censa tu negocio →</span>
      <span class="cta-texto">
        Si no apareces en el censo, quedas fuera de todas las ayudas que
        vengan después. Es lo más urgente.
      </span>
    </a>

    <a class="cta-secundaria" href={`${base}/iniciativas`}>
      <strong>¿Necesitas ayuda humanitaria, no información de negocios?</strong>
      <span>
        Centros de acopio, búsqueda de personas y ayuda urgente, en un solo sitio →
      </span>
    </a>
  </div>

  {/* Alivios bancarios, tributarios, crédito y beneficios privados: son
      generales, no de una ciudad en particular, así que van aquí en el hub
      del evento. Cada página de localidad muestra solo el resumen, con un
      enlace por ayuda a su ancla (#slug) aquí abajo. */}
  <h2>Ayudas generales para negocios</h2>
  {
    evento.ayudas.map((a) => (
      <section class="caja" id={a.slug}>
        <h3>{a.titulo}</h3>
        <p><strong>{a.resumen}</strong></p>
        {a.detalle.split("\n\n").map((parrafo) => <p>{parrafo}</p>)}
        {a.pendiente && (
          <p class="caja-pendiente">
            <strong>En verificación.</strong> {a.pendiente}
          </p>
        )}
        <Fuentes fuentes={a.fuentes} />
      </section>
    ))
  }

  <h2>Qué pasó</h2>
  <p>{evento.resumen}</p>
  <Imagen credito={IMG_MAPA} ancho={740} />
  <ul class="datos-evento">
    <li><strong>Fecha:</strong> {formatearFecha(evento.fecha)}</li>
    {evento.detalles.map((d) => (
      <li><strong>{d.etiqueta}:</strong> {d.valor}</li>
    ))}
  </ul>

  <h2>Por qué esto va de negocios</h2>
  <p>
    Golpeó a <strong>{n(evento.impacto.empresas)} empresas</strong> en {evento.impacto.ambito}.
    De ellas, {n(evento.impacto.microempresas)} son microempresas: el{" "}
    {Math.round((evento.impacto.microempresas / evento.impacto.empresas) * 100)} %.
    Son {n(evento.impacto.empleos)} empleos formales en riesgo.
  </p>
  <p>
    Ese perfil de negocio no tiene abogado ni contador que le rastree a qué
    puede acceder. Por eso existe esta guía.
  </p>

  {
    evento.cifras && (
      <div class="caja caja-gris">
        <p><strong>Cifras oficiales</strong></p>
        <p>
          A {formatearFecha(evento.cifras.fecha)}:{" "}
          {evento.cifras.lineas
            .map((l) => `${n(l.valor)} ${l.etiqueta}`)
            .join(", ")}
          . Fuente:{" "}
          <a href={evento.cifras.fuenteUrl} target="_blank" rel="noopener">
            {evento.cifras.fuente}
          </a>
          . {evento.cifras.aviso}
        </p>
      </div>
    )
  }

  <CompartirWhatsApp
    ruta={base}
    texto={`Si tu negocio resultó afectado por ${evento.nombre}, aquí está la guía de qué hacer y qué ayudas puedes pedir:`}
  />
</Base>
