---
/*
 * Cuentas que están contando lo que pasa: solo la grilla de perfiles, sin
 * publicaciones incrustadas. El componente Incrustado y el campo `destacados`
 * de Cuenta siguen en el código por si se vuelven a mostrar más adelante.
 */
import { Image } from "astro:assets";
import Base from "../../../layouts/Base.astro";
import Breadcrumbs from "../../../components/Breadcrumbs.astro";
import CompartirWhatsApp from "../../../components/CompartirWhatsApp.astro";
import { todosLosEventos } from "../../../data/paises";
import type { Evento, Pais, Red } from "../../../data/tipos";
import { enlaceWhatsApp } from "../../../data/contacto";

/*
 * Sin la foto de perfil de cada persona (no la tenemos con permiso, ver
 * commit), el avatar de las cuentas personales es un círculo de color con su
 * inicial. El color sale del propio handle -siempre el mismo para la misma
 * cuenta- entre una paleta que ya usa el resto del sitio, para que no
 * desentone.
 */
const PALETA_AVATAR = ["azul", "naranja", "ambar", "verde", "rojo"];
function colorDeAvatar(handle: string) {
  let hash = 0;
  for (let i = 0; i < handle.length; i++) hash = (hash * 31 + handle.charCodeAt(i)) >>> 0;
  return PALETA_AVATAR[hash % PALETA_AVATAR.length];
}

export function getStaticPaths() {
  return todosLosEventos().map(({ pais, evento }) => ({
    params: { pais: pais.slug, evento: evento.slug },
    props: { pais, evento },
  }));
}

interface Props {
  pais: Pais;
  evento: Evento;
}
const { pais, evento } = Astro.props;
const base = `/${pais.slug}/${evento.slug}`;

const URL_RED: Record<Red, (h: string) => string> = {
  instagram: (h) => `https://instagram.com/${h}`,
  tiktok: (h) => `https://tiktok.com/@${h}`,
  youtube: (h) => `https://youtube.com/@${h}`,
  x: (h) => `https://x.com/${h}`,
};
---

<Base
  titulo="Cuentas que están contando lo que pasa"
  descripcion={`Creadores, medios y organizaciones que están informando y moviendo ayuda tras ${evento.nombre}. Enlazamos sus perfiles para que puedas seguirlos y compartir su trabajo.`}
  ruta={`${base}/cuentas`}
>
  <Breadcrumbs
    items={[
      { nombre: "Inicio", href: "/" },
      { nombre: pais.nombre, href: `/${pais.slug}` },
      { nombre: evento.nombreCorto, href: base },
      { nombre: "Cuentas" },
    ]}
  />

  <h1>Cuentas que están contando lo que pasa</h1>

  <p class="entradilla">
    Gente que está usando su altavoz para mover ayuda, difundir búsquedas y
    enseñar lo que de verdad está ocurriendo. Síguelas, y sobre todo comparte lo
    que publican.
  </p>

  <div class="caja caja-pendiente">
    <p>
      <strong>Enlazar no es certificar.</strong> Esta es una lista curada a
      mano: cuentas que estamos mirando nosotros porque han publicado algo útil.
      No las hemos auditado una por una y no podemos garantizar todo lo que
      publiquen a partir de ahora.
    </p>
    <p>
      Antes de dar por buena una cifra o un aviso, contrástalo en la{" "}
      <a href={`${base}/iniciativas#noticias-falsas`}>página de noticias falsas y verificadores</a>. Y si
      ves que alguna comparte algo falso, dínoslo y la quitamos.
    </p>
  </div>

  <ul class="cuentas">
    {
      evento.cuentas.map((c) => (
        <li>
          <a href={URL_RED[c.red](c.handle)} target="_blank" rel="noopener">
            {c.logo ? (
              <Image src={c.logo} alt="" width={96} loading="lazy" class="cuenta-avatar" />
            ) : (
              <span
                class={`cuenta-avatar cuenta-avatar-inicial avatar-${colorDeAvatar(c.handle)}`}
                aria-hidden="true"
              >
                {c.handle.charAt(0).toUpperCase()}
              </span>
            )}
            <strong>@{c.handle}</strong>
            {c.nota && <span class="depto">{c.nota}</span>}
          </a>
        </li>
      ))
    }
  </ul>

  <h2>¿Conoces alguna más?</h2>
  <p>
    Si estás viendo a alguien haciendo un buen trabajo —contando lo que pasa,
    moviendo donaciones, ayudando a encontrar gente— mándanoslo y lo añadimos.
  </p>
  <p>
    <a
      href={enlaceWhatsApp(
        "Hola. Os propongo esta cuenta para la página de quién está contando lo que pasa:",
      )}
      target="_blank"
      rel="noopener"
    >
      <strong>Proponer una cuenta →</strong>
    </a>
  </p>

  <div class="caja caja-acento">
    <p>
      <strong>¿Y si eres tú quien tiene el altavoz?</strong> Puedes hacer algo
      más directo que difundir: adoptar un negocio concreto y contarlo a tu
      gente hasta que vuelva a levantar cabeza.
    </p>
    <p>
      <a href={`${base}/negocios/adopta`}>
        <strong>Adopta un comercio →</strong>
      </a>
    </p>
  </div>

  <CompartirWhatsApp
    ruta={`${base}/cuentas`}
    texto="Estas cuentas están contando lo que pasa tras el terremoto y moviendo ayuda. Vale la pena seguirlas y compartir lo que publican:"
  />
</Base>
