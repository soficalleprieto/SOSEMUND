---
import { Image } from "astro:assets";
import Base from "../../../../layouts/Base.astro";
import Breadcrumbs from "../../../../components/Breadcrumbs.astro";
import CompartirWhatsApp from "../../../../components/CompartirWhatsApp.astro";
import { todosLosEventos } from "../../../../data/paises";
import { ETIQUETA_DANO } from "../../../../data/tipos";
import type { Evento, Negocio, Pais } from "../../../../data/tipos";
import { formatearFecha } from "../../../../utils/fecha";
import { enlaceWhatsApp } from "../../../../data/contacto";

export function getStaticPaths() {
  return todosLosEventos().flatMap(({ pais, evento }) =>
    evento.negocios.map((negocio) => ({
      params: { pais: pais.slug, evento: evento.slug, negocio: negocio.slug },
      props: { pais, evento, negocio },
    })),
  );
}

interface Props {
  pais: Pais;
  evento: Evento;
  negocio: Negocio;
}
const { pais, evento, negocio: n } = Astro.props;
const base = `/${pais.slug}/${evento.slug}`;
const localidad = evento.localidades.find((l) => l.slug === n.localidad);

const REDES: [keyof typeof n.contacto, string][] = [
  ["whatsapp", "WhatsApp"],
  ["instagram", "Instagram"],
  ["facebook", "Facebook"],
  ["tiktok", "TikTok"],
  ["web", "Web"],
  ["telefono", "Teléfono"],
  ["correo", "Correo"],
];
const enlaces = REDES.filter(([k]) => n.contacto[k]);

const urlFicha = new URL(`${base}/negocios/${n.slug}`, Astro.site).href;
const mensajeApadrinar = `Hola. Quiero apadrinar este negocio: ${n.nombre} (${urlFicha}).

Dónde publico (Instagram, TikTok, YouTube…):
Cuánta gente me sigue, más o menos:
Qué tipo de contenido hago:`;

/*
 * LocalBusiness en JSON-LD, solo para fichas reales: nunca para la de
 * ejemplo (sería fabricar un registro sobre un negocio que no existe) y sin
 * `address`/`geo`, porque nunca publicamos la ubicación exacta de un negocio
 * (regla del sitio: no dar la dirección de un local que pudo quedar vacío).
 */
const schemaNegocio = !n.esEjemplo && {
  "@context": "https://schema.org",
  "@type": "LocalBusiness",
  name: n.nombre,
  description: n.historia,
  url: urlFicha,
  areaServed: localidad?.nombre,
  sameAs: Object.values(n.contacto).filter(
    (v): v is string => typeof v === "string" && v.startsWith("http"),
  ),
};
---

<Base
  titulo={n.esEjemplo ? "Así se ve la ficha de un negocio" : n.nombre}
  descripcion={
    n.esEjemplo
      ? "Ficha de ejemplo para que veas cómo se publica un negocio afectado: cómo quedó, qué necesita y por dónde contactarlo."
      : `${n.actividad} en ${localidad?.nombre}. Cómo quedó tras ${evento.nombre}, qué necesita y cómo apoyarlo.`
  }
  ruta={`${base}/negocios/${n.slug}`}
  noIndexar={n.esEjemplo}
>
  {schemaNegocio && <script type="application/ld+json" set:html={JSON.stringify(schemaNegocio)} />}

  <Breadcrumbs
    items={[
      { nombre: "Inicio", href: "/" },
      { nombre: pais.nombre, href: `/${pais.slug}` },
      { nombre: evento.nombreCorto, href: base },
      { nombre: "Negocios", href: `${base}/negocios` },
      { nombre: n.nombre },
    ]}
  />

  {
    n.esEjemplo && (
      <div class="caja caja-alerta">
        <p class="titulo-alerta">Esto es un ejemplo. Este negocio no existe.</p>
        <p>
          Lo publicamos para que veas cómo queda una ficha antes de mandarnos la
          tuya. No inventamos negocios afectados: en cuanto llegue el primero de
          verdad, esta página deja de estar la primera.
        </p>
        <p class="meta">
          El WhatsApp, las redes y las cuentas de cobro que ves más abajo
          también están inventados, para que veas cómo queda esa parte de la
          ficha: no escribas ni mandes dinero a ninguno.
        </p>
      </div>
    )
  }

  {
    n.fotos?.antes && n.fotos?.despues && (
      <div class="comparacion comparacion-hero">
        <figure>
          <Image
            src={n.fotos.antes.src}
            alt={n.fotos.antes.alt}
            width={500}
            densities={[1, 2]}
            loading="eager"
          />
          <figcaption>Antes</figcaption>
        </figure>
        <figure>
          <Image
            src={n.fotos.despues.src}
            alt={n.fotos.despues.alt}
            width={500}
            densities={[1, 2]}
            loading="eager"
          />
          <figcaption>Después</figcaption>
        </figure>
      </div>
    )
  }

  <h1>{n.nombre}</h1>
  {
    n.apadrinado && (
      <p class="cartel-apadrinado">
        Negocio apadrinado por{" "}
        <a href={n.apadrinado.enlace} target="_blank" rel="noopener">
          {n.apadrinado.nombre}
        </a>
      </p>
    )
  }
  <p class="meta">
    {n.actividad}
    {localidad && <> · <a href={`${base}/${localidad.slug}`}>{localidad.nombre}</a></>}
    {n.operando ? <> · <strong class="sigue-abierto">Sigue vendiendo</strong></> : null}
  </p>

  <p class="entradilla">{n.historia}</p>

  <h2>Cómo quedó</h2>
  {
    /*
     * Si las tres vienen "sin-datos" no es que el negocio esté intacto: es
     * que quien la dio de alta contó todo junto, en un solo texto, sin
     * desglosar local/mercancía/equipos (así llega, por ejemplo, desde el
     * mensaje de WhatsApp). Tres etiquetas "Sin datos" seguidas no informan
     * nada y parecen un error; mejor dejar que hable el detalle de abajo.
     */
  }
  {
    (n.estado.local !== "sin-datos" ||
      n.estado.mercancia !== "sin-datos" ||
      n.estado.equipos !== "sin-datos") && (
      <ul class="danos">
        <li><span>Local</span> <strong>{ETIQUETA_DANO[n.estado.local]}</strong></li>
        <li><span>Mercancía</span> <strong>{ETIQUETA_DANO[n.estado.mercancia]}</strong></li>
        <li><span>Equipos</span> <strong>{ETIQUETA_DANO[n.estado.equipos]}</strong></li>
      </ul>
    )
  }
  {n.estado.detalle && <p>{n.estado.detalle}</p>}

  {
    n.dondeEstaAhora && (
      <div class="caja caja-acento">
        <p><strong>Dónde encontrarlo hoy</strong></p>
        <p>{n.dondeEstaAhora}</p>
      </div>
    )
  }

  <h2>Qué necesita</h2>
  <ul class="necesita">
    {n.necesita.map((x) => <li>{x}</li>)}
  </ul>

  {
    n.fotos?.otras && n.fotos.otras.length > 0 && (
      <>
        <h2>Más fotos</h2>
        <div class="galeria">
          {n.fotos.otras.map((f) => (
            <Image src={f.src} alt={f.alt} width={700} densities={[1, 2]} loading="lazy" />
          ))}
        </div>
      </>
    )
  }

  {
    n.video && (
      <p>
        <a href={n.video.url} target="_blank" rel="noopener">
          Ver el vídeo: {n.video.descripcion} →
        </a>
      </p>
    )
  }

  <h2>Cómo apoyarlo</h2>
  {
    enlaces.length > 0 ? (
      <ul class="enlaces-localidades">
        {enlaces.map(([k, etiqueta]) => (
          <li>
            <a href={n.contacto[k]} target="_blank" rel="noopener">
              {etiqueta}
            </a>
          </li>
        ))}
      </ul>
    ) : (
      <p class="caja-pendiente">
        En una ficha real, aquí van sus redes y su WhatsApp para que le escribas
        directamente.
      </p>
    )
  }

  {
    n.cobro && n.cobro.length > 0 && (
      <div class="caja caja-gris">
        <p><strong>Si quieres comprarle o apoyarle con dinero</strong></p>
        <ul>
          {n.cobro.map((c) => (
            <li>
              {c.metodo}: <strong>{c.detalle}</strong>
            </li>
          ))}
        </ul>
        <p class="meta">
          El pago va directo al negocio. Nosotros no recaudamos, no
          intermediamos y no nos quedamos ninguna comisión.
        </p>
      </div>
    )
  }

  <p class="meta">
    Ficha revisada por una persona el {formatearFecha(n.revisadaEl)} y publicada
    con permiso de quien regenta el negocio.
  </p>

  {
    !n.esEjemplo && !n.apadrinado && (
      <a class="cta" href={enlaceWhatsApp(mensajeApadrinar)} target="_blank" rel="noopener">
        <span class="cta-eyebrow">¿Creas contenido?</span>
        <span class="cta-titulo">Apadrinar este negocio →</span>
        <span class="cta-texto">
          Le das visibilidad gratis a tu manera: un vídeo, unas stories, un
          post. Te ponemos en contacto directo con quien lo regenta.
        </span>
      </a>
    )
  }

  <a class="cta" href={`${base}/negocios/alta`}>
    <span class="cta-eyebrow">¿Tu negocio también resultó afectado?</span>
    <span class="cta-titulo">Publica el tuyo, es gratis →</span>
    <span class="cta-texto">
      Nos mandas cuatro cosas por WhatsApp y nosotros montamos la ficha.
    </span>
  </a>

  <CompartirWhatsApp
    ruta={`${base}/negocios/${n.slug}`}
    texto={
      n.esEjemplo
        ? "Así se ve la ficha de un negocio en S.O.S.EMUND:"
        : `${n.nombre} resultó afectado por el terremoto y sigue adelante. Mira qué necesita:`
    }
  />
</Base>
