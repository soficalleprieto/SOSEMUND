---
import Base from "../../../../layouts/Base.astro";
import CompartirWhatsApp from "../../../../components/CompartirWhatsApp.astro";
import TarjetaNegocio from "../../../../components/TarjetaNegocio.astro";
import { todosLosEventos } from "../../../../data/paises";
import type { Evento, Pais } from "../../../../data/tipos";

export function getStaticPaths() {
  return todosLosEventos().map(({ pais, evento }) => ({
    params: { pais: pais.slug, evento: evento.slug },
    props: { pais, evento },
  }));
}

interface Props {
  pais: Pais;
  evento: Evento;
}
const { pais, evento } = Astro.props;
const base = `/${pais.slug}/${evento.slug}`;

const reales = evento.negocios.filter((n) => !n.esEjemplo);
const ejemplos = evento.negocios.filter((n) => n.esEjemplo);
---

<Base
  titulo="Negocios afectados que siguen adelante"
  descripcion={`Negocios afectados por ${evento.nombre}: qué eran, cómo quedaron, qué necesitan y cómo apoyarlos. Publicar el tuyo es gratis.`}
  ruta={`${base}/negocios`}
>
  <nav class="migas">
    <a href="/">Inicio</a> › <a href={`/${pais.slug}`}>{pais.nombre}</a> ›{" "}
    <a href={base}>{evento.nombreCorto}</a> › Negocios
  </nav>

  <h1>Negocios que siguen adelante</h1>

  <p class="entradilla">
    Cada uno con su cara, su historia y lo que necesita en concreto. Porque la
    mejor manera de ayudar a un negocio es ser su cliente.
  </p>

  <!--
    Por ahora son accesos directos a las páginas que ya existen, no filtros
    de verdad: eso pide JavaScript o generar páginas por combinación, y con
    un solo negocio publicado sería adelantarse. El sitio queda con esta
    misma forma (tarjeta grande + tarjeta de color + fila de accesos) para
    que, cuando haya negocios suficientes por categorizar, sea cuestión de
    convertir estos enlaces en filtros reales sin rehacer el diseño.
  -->
  <div class="acciones-negocios">
    <a class="accion accion-principal" href={`${base}/negocios/anadir`}>
      <span class="accion-icono" aria-hidden="true">🏚️</span>
      <span class="accion-titulo">Mi negocio resultó afectado</span>
      <span class="accion-texto">Publícalo gratis, en cinco minutos</span>
    </a>
    <a class="accion accion-secundaria" href={`${base}/negocios/adopta`}>
      <span class="accion-icono" aria-hidden="true">📣</span>
      <span class="accion-titulo">Quiero apadrinar uno</span>
      <span class="accion-texto">Visibilidad gratis a un negocio concreto</span>
    </a>
    <div class="acciones-fila">
      <a href={`${base}/negocios/proponer`}>
        <span class="accion-icono" aria-hidden="true">👀</span>
        Conozco uno que no es mío
      </a>
      <a href="#negocios-publicados">
        <span class="accion-icono" aria-hidden="true">🧾</span>
        Ver los negocios publicados
      </a>
    </div>
  </div>

  <div id="negocios-publicados">
    {
      reales.length === 0 && (
        <div class="caja caja-pendiente">
          <p>
            <strong>Todavía no hay ninguno publicado.</strong> Acabamos de
            abrir esta sección y no vamos a inventarnos negocios para que
            parezca llena: sería mentir sobre una catástrofe.
          </p>
          <p>
            Abajo tienes una ficha de ejemplo para que veas cómo queda. Si
            tienes un negocio afectado, el tuyo puede ser el primero.
          </p>
        </div>
      )
    }

    {
      reales.length > 0 && (
        <ul class="lista-negocios">
          {reales.map((n) => (
            <TarjetaNegocio negocio={n} evento={evento} base={base} />
          ))}
        </ul>
      )
    }

    {
      ejemplos.length > 0 && (
        <>
          <h2>Así queda una ficha</h2>
          <ul class="lista-negocios">
            {ejemplos.map((n) => (
              <TarjetaNegocio negocio={n} evento={evento} base={base} />
            ))}
          </ul>
        </>
      )
    }
  </div>

  <h2>¿Conoces uno que no es tuyo?</h2>
  <p>
    Quien acaba de quedarse sin local no está navegando por internet buscando
    ayuda. Pero tú sí llegaste hasta aquí. Si conoces la panadería o el taller
    de tu barrio, cuéntanoslo y nosotros les buscamos.
  </p>
  <p>
    <a href={`${base}/negocios/proponer`}>
      <strong>Proponer un negocio →</strong>
    </a>
  </p>

  <h2>¿Eres creador de contenido?</h2>
  <p>
    Tras la DANA de Valencia, la iniciativa «Adopta un Comercio» juntó 880
    negocios con 823 creadores en menos de una semana. Un vídeo tuyo enseñando
    un negocio concreto vale más que cualquier campaña.
  </p>
  <p>
    <a href={`${base}/negocios/adopta`}>
      <strong>Adopta un comercio, así funciona →</strong>
    </a>
  </p>

  <CompartirWhatsApp
    ruta={`${base}/negocios`}
    texto="Si tu negocio resultó afectado por el terremoto, aquí puedes publicarlo gratis para que la gente sepa qué necesitas:"
  />
</Base>
