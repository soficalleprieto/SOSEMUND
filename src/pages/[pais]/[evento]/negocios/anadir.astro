---
import Base from "../../../../layouts/Base.astro";
import { todosLosEventos } from "../../../../data/paises";
import type { Evento, Pais } from "../../../../data/tipos";
import { WHATSAPP, QUE_MANDAR, TIPOS_NEGOCIO_BASE, POR_QUE_ESPANA } from "../../../../data/contacto";

export function getStaticPaths() {
  return todosLosEventos().map(({ pais, evento }) => ({
    params: { pais: pais.slug, evento: evento.slug },
    props: { pais, evento },
  }));
}

interface Props {
  pais: Pais;
  evento: Evento;
}
const { pais, evento } = Astro.props;
const base = `/${pais.slug}/${evento.slug}`;
---

<Base
  titulo="Publica tu negocio, es gratis"
  descripcion="Si tu negocio resultó afectado, publicamos su ficha gratis: qué era, cómo quedó, qué necesita y por dónde contactarte. Rellena el formulario y lo mandas por WhatsApp."
  ruta={`${base}/negocios/anadir`}
>
  <nav class="migas">
    <a href="/">Inicio</a> › <a href={`/${pais.slug}`}>{pais.nombre}</a> ›{" "}
    <a href={base}>{evento.nombreCorto}</a> ›{" "}
    <a href={`${base}/negocios`}>Negocios</a> › Publicar el mío
  </nav>

  <h1>Publica tu negocio, es gratis</h1>

  <p class="entradilla">
    Si tu negocio resultó afectado, le hacemos una página contando qué era, cómo
    quedó y qué necesita. Para que puedas compartirla y para que quien quiera
    ayudarte sepa exactamente cómo.
  </p>

  <p>
    Rellena esto y al final se abre WhatsApp con el mensaje ya escrito para que
    lo mandes. Ahí mismo, en el chat, adjuntas tus fotos o vídeos: eso un
    formulario no lo puede hacer por ti.
  </p>

  <div class="caja caja-gris">
    <p>{POR_QUE_ESPANA}</p>
  </div>

  <h2>Qué mandarnos</h2>
  <ol class="pasos">
    {
      QUE_MANDAR.map((paso, i) => (
        <li>
          <span class="numero">{i + 1}</span>
          <div>
            <p class="paso-titulo">{paso.titulo}</p>
            <p>{paso.texto}</p>
          </div>
        </li>
      ))
    }
  </ol>

  <form id="form-negocio" class="form-negocio">
    <div class="campo">
      <label for="f-nombre">Cómo se llama tu negocio</label>
      <input type="text" id="f-nombre" required />
    </div>

    <div class="campo">
      <label for="f-localidad">Localidad</label>
      <select id="f-localidad" required>
        <option value="">Elige tu localidad</option>
        {evento.localidades.map((l) => <option value={l.nombre}>{l.nombre}</option>)}
        <option value="otra">No está en la lista</option>
      </select>
      <input
        type="text"
        id="f-localidad-otra"
        placeholder="¿Cuál es tu localidad?"
        hidden
      />
    </div>

    <div class="campo">
      <label for="f-tipo">Tipo de negocio</label>
      <select id="f-tipo" required>
        <option value="">Elige el que más se parezca</option>
        {TIPOS_NEGOCIO_BASE.map((t) => <option value={t}>{t}</option>)}
        <option value="otro">No encaja en ninguno</option>
      </select>
      <input type="text" id="f-tipo-otro" placeholder="¿A qué se dedica?" hidden />
    </div>

    <div class="campo">
      <label for="f-quedo">Cómo quedó</label>
      <p class="campo-ayuda">
        El local, la mercancía y los equipos. Si eras un puesto callejero o algo
        que ya no existe para fotografiar, cuéntalo aquí.
      </p>
      <textarea id="f-quedo" rows="4" required></textarea>
    </div>

    <div class="campo caja caja-pendiente">
      <p>
        <strong>No olvides tus fotos.</strong> Cuando mandes el mensaje, adjunta
        en el mismo chat una foto de antes (aunque sea del celular, de una
        publicación vieja o de Google Maps) y una de ahora: se ve mucho mejor
        el contraste. Un formulario no puede adjuntarlas por ti.
      </p>
    </div>

    <div class="campo">
      <label for="f-necesita">Qué necesitas exactamente</label>
      <p class="campo-ayuda">
        Concreto: «una vitrina refrigerada», «clientes para pedidos a
        domicilio». «Ayuda» a secas no le sirve a nadie para ayudarte.
      </p>
      <textarea id="f-necesita" rows="3" required></textarea>
    </div>

    <div class="campo">
      <label for="f-donde">Dónde te encuentran hoy</label>
      <p class="campo-ayuda">
        Si sigues vendiendo en otro sitio, a domicilio o por encargo. No hace
        falta si tu local sigue en pie.
      </p>
      <textarea id="f-donde" rows="2"></textarea>
    </div>

    <div class="campo">
      <label>Por dónde te pueden escribir</label>
      <p class="campo-ayuda">Lo que tengas, no hace falta rellenarlo todo.</p>
      <div class="campo-fila">
        <input type="text" id="f-whatsapp" placeholder="WhatsApp" />
        <input type="text" id="f-instagram" placeholder="Instagram" />
        <input type="text" id="f-facebook" placeholder="Facebook" />
      </div>
      <div class="campo-fila">
        <input type="text" id="f-tiktok" placeholder="TikTok" />
        <input type="text" id="f-web" placeholder="Página web" />
        <input type="text" id="f-telefono" placeholder="Teléfono" />
      </div>
    </div>

    <div class="campo">
      <label for="f-ayuda">¿Cómo puede ayudarte quien lea esto?</label>
      <p class="campo-ayuda">
        Comprarte, recomendarte, hacer pedidos, seguirte en redes... Si quieres
        recibir pagos directos (Nequi, Daviplata, Bre-B), cuéntanoslo aquí y lo
        hablamos por WhatsApp: esa cuenta la confirmamos contigo antes de
        publicarla, nunca la ponemos solo porque alguien la escribió.
      </p>
      <textarea id="f-ayuda" rows="3"></textarea>
    </div>

    <button type="submit" class="cta">
      <span class="cta-eyebrow">Último paso</span>
      <span class="cta-titulo">Mandar mi negocio por WhatsApp →</span>
      <span class="cta-texto">{WHATSAPP.visible}</span>
    </button>
  </form>

  <h2>Cómo lo tratamos</h2>
  <div class="caja caja-acento">
    <p>
      <strong>Lo revisa una persona antes de publicarse.</strong> Nada se
      publica solo. Comprobamos que el negocio existe y que quien escribe es
      quien lo regenta.
    </p>
    <p>
      <strong>Publicamos dónde estás hoy, no dónde quedó tu local vacío.</strong>{" "}
      Tras los derrumbes hubo saqueos. Si tu local está vacío, no damos su
      dirección.
    </p>
    <p>
      <strong>No tocamos tu dinero.</strong> Si quieres recibir pagos,
      publicamos tu Nequi, tu Daviplata o tu Bre-B y el dinero te llega
      directo. No recaudamos ni cobramos comisión, y confirmamos esa cuenta
      contigo antes de publicarla: nunca publicamos una solo porque alguien la
      escribió.
    </p>
    <p>
      <strong>Es tuyo y puedes retirarlo.</strong> Escribes al mismo WhatsApp y
      quitamos o corregimos tu ficha. Sin explicaciones.
    </p>
    <p class="meta">
      Publicamos solo lo que nos autorices. Puedes ver el detalle en la{" "}
      <a href="/privacidad">política de privacidad</a>.
    </p>
  </div>

  <h2>¿Y si no tengo fotos?</h2>
  <p>
    Da igual. Manda el formulario igual y en el chat de WhatsApp cuenta lo que
    puedas: montamos la ficha con eso. Una ficha sin fotos sirve más que
    ninguna ficha. Y si luego consigues fotos, nos las mandas y las añadimos.
  </p>

  <p>
    <a href={`${base}/negocios/ejemplo`}>
      <strong>Mira antes cómo queda una ficha →</strong>
    </a>
  </p>

  <script define:vars={{ numero: WHATSAPP.numero }}>
    {
      /*
       * Sin servidor: el formulario no manda nada a ningún sitio nuestro, solo
       * arma el texto y abre WhatsApp con él ya escrito, igual que hacían antes
       * los enlaces de "mándanos un mensaje". Las fotos las adjunta la persona
       * a mano en el chat: eso ningún enlace lo puede hacer por ella.
       */
    }
    const form = document.getElementById("form-negocio");

    function alternarOtro(selectId, otroId, valorOtro) {
      const select = document.getElementById(selectId);
      const otro = document.getElementById(otroId);
      select.addEventListener("change", () => {
        const esOtro = select.value === valorOtro;
        otro.hidden = !esOtro;
        otro.required = esOtro;
        if (esOtro) otro.focus();
      });
    }
    alternarOtro("f-localidad", "f-localidad-otra", "otra");
    alternarOtro("f-tipo", "f-tipo-otro", "otro");

    function val(id) {
      return document.getElementById(id).value.trim();
    }

    function construirMensaje() {
      const selLocalidad = document.getElementById("f-localidad");
      const localidad =
        selLocalidad.value === "otra" ? val("f-localidad-otra") : selLocalidad.value;

      const selTipo = document.getElementById("f-tipo");
      const tipo = selTipo.value === "otro" ? val("f-tipo-otro") : selTipo.value;

      let msg =
        "Hola. Mi negocio resultó afectado por el terremoto y quiero publicar su ficha en S.O.S.EMUND.\n\n";
      msg += `Nombre: ${val("f-nombre")}\n`;
      msg += `Localidad: ${localidad}\n`;
      msg += `Tipo de negocio: ${tipo}\n\n`;
      msg += `Cómo quedó:\n${val("f-quedo")}\n\n`;
      msg += `Qué necesita:\n${val("f-necesita")}\n`;

      const donde = val("f-donde");
      if (donde) msg += `\nDónde lo encuentran hoy:\n${donde}\n`;

      const contactos = [
        ["WhatsApp", val("f-whatsapp")],
        ["Instagram", val("f-instagram")],
        ["Facebook", val("f-facebook")],
        ["TikTok", val("f-tiktok")],
        ["Web", val("f-web")],
        ["Teléfono", val("f-telefono")],
      ].filter(([, valor]) => valor);
      if (contactos.length > 0) {
        msg += "\nPor dónde me pueden escribir:\n";
        msg += contactos.map(([etiqueta, valor]) => `${etiqueta}: ${valor}`).join("\n");
        msg += "\n";
      }

      const comoAyudar = val("f-ayuda");
      if (comoAyudar) msg += `\nCómo me pueden ayudar:\n${comoAyudar}\n`;

      msg += "\n(Voy a mandar la foto de antes y de ahora en este chat.)";
      return msg;
    }

    form.addEventListener("submit", (e) => {
      e.preventDefault();
      const mensaje = construirMensaje();
      window.open(`https://wa.me/${numero}?text=${encodeURIComponent(mensaje)}`, "_blank");
    });
  </script>
</Base>
