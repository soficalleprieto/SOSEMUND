---
import Base from "../../../layouts/Base.astro";
import CompartirWhatsApp from "../../../components/CompartirWhatsApp.astro";
import Fuentes from "../../../components/Fuentes.astro";
import Imagen from "../../../components/Imagen.astro";
import { todasLasLocalidades } from "../../../data/paises";
import { IMAGEN_POR_LOCALIDAD } from "../../../data/imagenes";
import type { Localidad, Evento, Pais } from "../../../data/tipos";

// Una plantilla, todas las localidades de todas las emergencias.
export function getStaticPaths() {
  return todasLasLocalidades().map(({ pais, evento, localidad }) => ({
    params: { pais: pais.slug, evento: evento.slug, localidad: localidad.slug },
    props: { pais, evento, localidad },
  }));
}

interface Props {
  pais: Pais;
  evento: Evento;
  localidad: Localidad;
}
const { pais, evento, localidad: c } = Astro.props;
const base = `/${pais.slug}/${evento.slug}`;
const otras = evento.localidades.filter((o) => o.slug !== c.slug);
// Solo si existe una foto libre DE ESTA localidad. Nunca una genérica.
const foto = IMAGEN_POR_LOCALIDAD[c.slug];
---

<Base
  titulo={`Ayudas para negocios en ${c.nombre}`}
  descripcion={`Qué puede pedir un comerciante de ${c.nombre} tras ${evento.nombre}: cómo censarse, alivios bancarios, alivios tributarios y líneas de crédito. Con fuente y fecha.`}
  ruta={`${base}/${c.slug}`}
>
  <nav class="migas">
    <a href="/">Inicio</a> › <a href={`/${pais.slug}`}>{pais.nombre}</a> ›{" "}
    <a href={base}>{evento.nombreCorto}</a> › {c.nombre}
  </nav>

  <h1>Ayudas para negocios en {c.nombre}</h1>
  <p class="meta">
    {c.division}{c.alertaMaxima && " · Estuvo en alerta máxima tras la emergencia"}
  </p>
  {c.contexto && <p>{c.contexto}</p>}
  {foto && <Imagen credito={foto} prioritaria={true} />}
  {
    c.fuente && (
      <p class="meta">
        Fuente:{" "}
        <a href={c.fuente.url} target="_blank" rel="noopener">
          {c.fuente.medio}, {c.fuente.titulo}
        </a>
      </p>
    )
  }

  {/* El censo va primero en todas las páginas: es lo que desbloquea el resto. */}
  <section class="caja caja-acento">
    <h2 style="margin-top:0">Primero: cénsate</h2>
    <p>{c.censo.detalle}</p>
    {
      c.censo.telefonos && (
        <p>
          <strong>Líneas de atención: </strong>
          {c.censo.telefonos.map((t, i) => (
            <>
              {i > 0 && " · "}
              <a class="telefono" href={`tel:${t.replace(/\s/g, "")}`}>
                {t}
              </a>
            </>
          ))}
        </p>
      )
    }
    <p>
      <a href={`${base}/censo`}>
        <strong>Ver el paso a paso completo del censo →</strong>
      </a>
    </p>
    {c.censo.fuente && <Fuentes fuentes={[c.censo.fuente]} />}
  </section>

  {/* A diferencia de las generales, esto es solo de esta localidad: va
      completo aquí (no se repite en ningún otro sitio, así que no hace falta
      recortarlo ni mandarlo al hub). */}
  {
    c.ayudasPropias && c.ayudasPropias.length > 0 && (
      <>
        <h2>Ayudas propias de {c.nombre}</h2>
        {
          c.ayudasPropias.map((a) => (
            <section class="caja caja-acento">
              <h3>{a.titulo}</h3>
              <p><strong>{a.resumen}</strong></p>
              {a.detalle.split("\n\n").map((parrafo) => <p>{parrafo}</p>)}
              {a.pendiente && (
                <p class="caja-pendiente">
                  <strong>En verificación.</strong> {a.pendiente}
                </p>
              )}
              <Fuentes fuentes={a.fuentes} />
            </section>
          ))
        }
      </>
    )
  }

  {/* Solo el resumen: son ayudas generales, iguales en las 11 localidades.
      El detalle completo, con fuentes, vive en el hub del evento (cada una en
      su propia ancla #slug) para no repetir el mismo texto largo 11 veces. */}
  <h2>Ayudas generales para negocios</h2>
  <p class="meta">
    Esto no es solo de {c.nombre}: aplica igual en todas las localidades.
  </p>
  {
    evento.ayudas.map((a) => (
      <section class="caja">
        <h3>{a.titulo}</h3>
        <p>{a.resumen}</p>
        <p>
          <a href={`${base}#${a.slug}`}>
            <strong>Ver el detalle completo, con fuentes →</strong>
          </a>
        </p>
      </section>
    ))
  }

  <h2>Otras localidades</h2>
  <ul class="enlaces-localidades">
    {otras.map((o) => (
      <li>
        <a href={`${base}/${o.slug}`}>{o.nombre}</a>
      </li>
    ))}
  </ul>

  <CompartirWhatsApp
    ruta={`${base}/${c.slug}`}
    texto={`Ayudas para negocios afectados en ${c.nombre}: cómo censarte y qué puedes pedir.`}
  />
</Base>
