---
/*
 * Tarjeta de negocio para los listados (/negocios). Componente aparte porque
 * la usan tanto la lista de negocios reales como la de ejemplos, y repetir
 * este bloque en los dos sitios se desincroniza tarde o temprano.
 */
import { Image } from "astro:assets";
import { ETIQUETA_DANO } from "../data/tipos";
import type { Evento, Negocio } from "../data/tipos";
import { formatearFecha } from "../utils/fecha";

interface Props {
  negocio: Negocio;
  evento: Evento;
  base: string;
}
const { negocio: n, evento, base } = Astro.props;
const loc = evento.localidades.find((l) => l.slug === n.localidad);

const REDES: [keyof Negocio["contacto"], string][] = [
  ["whatsapp", "WhatsApp"],
  ["instagram", "Instagram"],
  ["facebook", "Facebook"],
  ["tiktok", "TikTok"],
  ["web", "Web"],
  ["telefono", "Teléfono"],
  ["correo", "Correo"],
];
const redes = REDES.filter(([k]) => n.contacto[k]).map(([, etiqueta]) => etiqueta);

/** Color de la etiqueta según qué tan grave es el daño: mismo semáforo en todas las tarjetas. */
const CLASE_DANO: Record<string, string> = {
  destruido: "etiqueta-mala",
  grave: "etiqueta-mala",
  leve: "etiqueta-media",
  intacto: "etiqueta-buena",
  "sin-datos": "etiqueta-neutra",
};
---

<li>
  <a href={`${base}/negocios/${n.slug}`}>
    {
      n.fotos?.antes && n.fotos?.despues && (
        <div class="comparacion-mini">
          <Image src={n.fotos.antes.src} alt="" width={300} loading="lazy" />
          <Image src={n.fotos.despues.src} alt="" width={300} loading="lazy" />
        </div>
      )
    }
    <div class="texto-tarjeta">
      <strong>{n.nombre}</strong>
      <span class="depto">
        {n.actividad}
        {loc && ` · ${loc.nombre}`}
      </span>

      <div class="etiquetas">
        <span class={`etiqueta ${CLASE_DANO[n.estado.local]}`}>
          Local: {ETIQUETA_DANO[n.estado.local]}
        </span>
        {n.operando && <span class="etiqueta etiqueta-buena">Sigue vendiendo</span>}
        {n.apadrinado && <span class="etiqueta etiqueta-acento">Apadrinado</span>}
        {n.dondeEstaAhora && (
          <span class="etiqueta etiqueta-neutra">Cambio temporal de ubicación</span>
        )}
      </div>

      {redes.length > 0 && <span class="redes-mini">{redes.join(" · ")}</span>}

      {
        n.esEjemplo && (
          <span class="depto">Ficha de ejemplo · este negocio no existe</span>
        )
      }

      <span class="revisado">Revisado {formatearFecha(n.revisadaEl)}</span>
    </div>
  </a>
</li>
