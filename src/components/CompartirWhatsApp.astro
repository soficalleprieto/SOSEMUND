---
/*
 * En Colombia la información entre comerciantes circula por WhatsApp.
 *
 * Es un enlace normal, no un botón con JavaScript: la URL de la página se
 * conoce en tiempo de compilación, así que el enlace se genera ya montado y
 * la página no necesita ni una línea de script.
 */
interface Props {
  texto: string;
  ruta: string;
}

const { texto, ruta } = Astro.props;
const url = new URL(ruta, Astro.site).href;
const mensaje = encodeURIComponent(`${texto}\n\n${url}`);
---

<a class="wa" href={`https://wa.me/?text=${mensaje}`} target="_blank" rel="noopener">
  <svg width="20" height="20" viewBox="0 0 24 24" fill="currentColor" aria-hidden="true">
    <path
      d="M17.5 14.4c-.3-.2-1.7-.9-2-1-.3-.1-.5-.2-.7.1-.2.3-.7 1-.9 1.2-.2.2-.3.2-.6.1-.3-.2-1.2-.5-2.3-1.4-.9-.8-1.4-1.7-1.6-2-.2-.3 0-.5.1-.6l.5-.5c.1-.2.2-.3.3-.5 0-.2 0-.4 0-.5 0-.2-.7-1.6-.9-2.2-.2-.5-.5-.5-.7-.5h-.6c-.2 0-.5.1-.8.4-.3.3-1 1-1 2.4s1.1 2.8 1.2 3c.2.2 2.1 3.2 5.1 4.4 1.9.8 2.6.9 3.5.7.6-.1 1.7-.7 1.9-1.3.2-.7.2-1.2.2-1.3-.1-.2-.3-.2-.6-.4M12 2a10 10 0 0 0-8.6 15.1L2 22l5-1.3A10 10 0 1 0 12 2m0 1.8a8.2 8.2 0 0 1 6.9 12.6l-.2.3.7 2.6-2.7-.7-.3.2A8.2 8.2 0 1 1 12 3.8"
    ></path>
  </svg>
  Compartir por WhatsApp
</a>
