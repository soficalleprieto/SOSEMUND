---
import "../styles/global.css";
import { ACTUALIZADO } from "../data/paises";
import { formatearFecha } from "../utils/fecha";
import Latido from "../components/Latido.astro";

interface Props {
  titulo: string;
  descripcion: string;
  /** Ruta canónica, p. ej. "/colombia/terremoto-2026/censo". */
  ruta: string;
  /**
   * Ruta al censo de la emergencia en la que está el lector. Las páginas de un
   * evento la pasan; la portada y los hubs de país no, porque un «censarme»
   * global no significaría nada cuando haya varias emergencias.
   */
  censoRuta?: string;
}

const { titulo, descripcion, ruta, censoRuta } = Astro.props;
const canonica = new URL(ruta, Astro.site).href;
const tituloCompleto = ruta === "/" ? titulo : `${titulo} | Negocios que Laten`;
---

<!doctype html>
<html lang="es">
  <head>
    <meta charset="utf-8" />
    <meta name="viewport" content="width=device-width, initial-scale=1" />
    <title>{tituloCompleto}</title>
    <meta name="description" content={descripcion} />
    <link rel="canonical" href={canonica} />

    <meta property="og:type" content="website" />
    <meta property="og:site_name" content="Negocios que Laten" />
    <meta property="og:locale" content="es_ES" />
    <meta property="og:title" content={tituloCompleto} />
    <meta property="og:description" content={descripcion} />
    <meta property="og:url" content={canonica} />
  </head>

  <body>
    <header class="cabecera">
      <div class="contenedor">
        <a class="marca" href="/">
          <Latido ancho={30} />
          Negocios que Laten
        </a>
        {censoRuta && <a class="enlace-censo" href={censoRuta}>Censar mi negocio</a>}
      </div>
    </header>

    <main>
      <div class="contenedor">
        <slot />
      </div>
    </main>

    <footer class="pie">
      <div class="contenedor">
        <Latido ancho={40} />
        <p><strong>Esto no es un canal oficial.</strong></p>
        <p>
          Somos una iniciativa ciudadana independiente. No recogemos datos
          personales, no gestionamos ayudas y no recaudamos dinero. Organizamos
          información pública y te enviamos al canal oficial que corresponde.
          Ante una emergencia, llama siempre al número de emergencias de tu país.
        </p>
        <p>Última actualización: {formatearFecha(ACTUALIZADO)}.</p>
      </div>
    </footer>
  </body>
</html>
