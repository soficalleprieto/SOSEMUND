---
import { Image } from "astro:assets";
import "../styles/global.css";
import { ACTUALIZADO, todosLosEventos } from "../data/paises";
import { formatearFecha } from "../utils/fecha";
import isotipo from "../assets/sosemund-isotipo.png";
import { MARCA } from "../data/marca";

interface Props {
  titulo: string;
  descripcion: string;
  /** Imagen social propia. Si no se pasa, va el logo de marca. */
  imagen?: string;
  /** Ruta canónica, p. ej. "/colombia/terremoto-2026/censo". */
  ruta: string;
  /** Para páginas que no deben salir en buscadores, como la ficha de ejemplo. */
  noIndexar?: boolean;
}

const { titulo, descripcion, ruta, noIndexar, imagen } = Astro.props;
const canonica = new URL(ruta, Astro.site).href;
const social = new URL(imagen ?? "/social.jpg", Astro.site).href;
const tituloCompleto = ruta === "/" ? titulo : `${titulo} | ${MARCA.nombre}`;

/*
 * El menú se construye desde la emergencia activa: mientras solo haya una, lo
 * útil es llevar directo a lo que se busca y no obligar a navegar país a país.
 * Cuando haya varias, aquí es donde habrá que replantearlo.
 */
const activa = todosLosEventos()[0];
const base = activa ? `/${activa.pais.slug}/${activa.evento.slug}` : "";

/*
 * Mega-menús con <details>/<summary> nativos: no necesitan ni una línea de
 * JavaScript. Cada uno tiene un id fijo ("menu-ayudas", "menu-negocios",
 * "menu-humanitaria") porque el CSS los engancha por id con :has(), ver
 * global.css. Se abren al pulsar (details nativo, funciona en táctil) y
 * también al pasar el cursor en escritorio (regla aparte en CSS).
 */
const MENU = activa
  ? [
      {
        texto: "Ayudas para negocios",
        href: base,
        id: "menu-ayudas",
        submenu: activa.evento.localidades.map((l) => ({
          texto: l.nombre,
          href: `${base}/${l.slug}`,
          descripcion: l.division,
        })),
      },
      {
        texto: "Negocios que te necesitan",
        href: `${base}/negocios`,
        id: "menu-negocios",
        submenu: [
          {
            texto: "Publica tu negocio",
            href: `${base}/negocios/anadir`,
            icono: "🏚️",
            descripcion: "Gratis, en cinco minutos por WhatsApp.",
          },
          {
            texto: "Quiero apadrinar un negocio",
            href: `${base}/negocios/adopta`,
            icono: "📣",
            descripcion: "Visibilidad gratis a un negocio concreto.",
          },
          {
            texto: "Conozco un negocio afectado",
            href: `${base}/negocios/proponer`,
            icono: "👀",
            descripcion: "Aunque no sea el tuyo, cuéntanoslo.",
          },
        ],
      },
      {
        texto: "Ayuda humanitaria",
        href: `${base}/iniciativas`,
        id: "menu-humanitaria",
        submenu: [
          {
            texto: "Centros de acopio",
            href: `${base}/iniciativas#acopio`,
            icono: "📦",
            descripcion: "Dónde llevar o pedir donaciones.",
          },
          {
            texto: "Necesito algo urgente hoy",
            href: `${base}/iniciativas#urgente`,
            icono: "🆘",
            descripcion: "Agua, comida, medicinas o un techo.",
          },
          {
            texto: "Buscar a una persona",
            href: `${base}/iniciativas#desaparecidos`,
            icono: "🔎",
            descripcion: "Plataformas ciudadanas de búsqueda.",
          },
          {
            texto: "Reportar daños en edificios",
            href: `${base}/iniciativas#danos`,
            icono: "🏚️",
            descripcion: "Evaluación técnica de tu inmueble.",
          },
          {
            texto: "Mascotas perdidas",
            href: `${base}/iniciativas#mascotas`,
            icono: "🐾",
            descripcion: "Búsqueda de mascotas.",
          },
        ],
      },
      { texto: "Quién lo cuenta", href: `${base}/cuentas` },
      { texto: "Sobre S.O.S.EMUND", href: "/sobre" },
    ]
  : [{ texto: "Sobre S.O.S.EMUND", href: "/sobre" }];

const aqui = Astro.url.pathname.replace(/(.)\/$/, "$1");
const limpia = (href: string) => href.replace(/(.)\/$/, "$1");
const esActual = (href: string) => aqui === limpia(href.split("#")[0]);
const estaDentro = (href: string) => aqui.startsWith(limpia(href));

const menusConSubmenu = MENU.filter(
  (m): m is (typeof MENU)[number] & { id: string; submenu: unknown[] } =>
    "submenu" in m && Array.isArray(m.submenu),
);
---

<!doctype html>
<html lang="es">
  <head>
    <meta charset="utf-8" />
    <meta name="viewport" content="width=device-width, initial-scale=1" />
    <title>{tituloCompleto}</title>
    <meta name="description" content={descripcion} />
    <link rel="canonical" href={canonica} />
    {noIndexar && <meta name="robots" content="noindex, follow" />}

    <meta property="og:type" content="website" />
    <meta property="og:site_name" content={MARCA.nombre} />
    <meta property="og:locale" content="es_ES" />
    <meta property="og:title" content={tituloCompleto} />
    <meta property="og:description" content={descripcion} />
    <meta property="og:url" content={canonica} />
    <meta property="og:image" content={social} />
    <meta property="og:image:width" content="1200" />
    <meta property="og:image:height" content="630" />
    <meta name="twitter:card" content="summary_large_image" />
  </head>

  <body>
    <a class="saltar" href="#contenido">Saltar al contenido</a>

    <header class="cabecera">
      <div class="contenedor">
        <a class="marca" href="/">
          <Image
            src={isotipo}
            alt=""
            width={46}
            densities={[1, 2]}
            loading="eager"
          />
          <span class="marca-texto">
            <span class="marca-nombre">{MARCA.nombre}</span>
            <span class="marca-descriptor">{MARCA.descriptor}</span>
          </span>
        </a>
      </div>

      <nav class="menu" aria-label="Secciones">
        <div class="contenedor">
          {
            MENU.map((m) => {
              if (!("submenu" in m) || !m.submenu) {
                return (
                  <a
                    href={m.href}
                    class:list={[{ actual: esActual(m.href) }]}
                    aria-current={esActual(m.href) ? "page" : undefined}
                  >
                    {m.texto}
                  </a>
                );
              }
              /* "Ayudas para negocios" cuelga de `base`, que es prefijo de
                 TODAS las rutas del evento: usa esActual, no estaDentro, o
                 se resaltaría en /cuentas, /negocios... */
              const enSeccion = m.id === "menu-ayudas" ? esActual(m.href) : estaDentro(m.href);
              return (
                /*
                 * El texto es un <a> normal que navega; la flechita es un
                 * <details> aparte solo para desplegar. Antes todo era un
                 * único <summary>, que nunca navega (solo alterna abierto/
                 * cerrado): al convertir "Ayudas" y "Ayuda humanitaria" en
                 * desplegables, sus páginas dejaron de tener enlace directo.
                 * El id va en el contenedor, no en el <details>, para que el
                 * :hover de CSS cubra el texto Y la flechita sin hueco.
                 *
                 * El <details> arranca SIEMPRE cerrado, incluso dentro de su
                 * propia sección: abrirlo por defecto tapaba el contenido de
                 * la página con el panel superpuesto. `enSeccion` solo pinta
                 * la píldora activa, no despliega nada.
                 */
                <div id={m.id} class:list={["menu-item-desplegable", { actual: enSeccion }]}>
                  <a href={m.href} aria-current={esActual(m.href) ? "page" : undefined}>
                    {m.texto}
                  </a>
                  <details>
                    <summary aria-label={`Ver ${m.texto}`}>
                      <span aria-hidden="true">▾</span>
                    </summary>
                  </details>
                </div>
              );
            })
          }
        </div>
      </nav>

      {
        /*
         * Los paneles viven fuera de <nav class="menu">, que tiene scroll
         * horizontal (overflow-x: auto): en CSS eso fuerza también
         * overflow-y a recortar, así que un panel absoluto ahí dentro
         * quedaba cortado. Aquí, colgados de <header>, no los recorta nada,
         * y :has() en el CSS los muestra u oculta según si su <details>
         * (por id) está abierto o el cursor está encima.
         */
        menusConSubmenu.map((m) => (
          <div class="menu-panel" data-para={m.id}>
            <div class="contenedor">
              {m.submenu.map((s: any) => (
                <a
                  href={s.href}
                  class:list={[{ actual: esActual(s.href) }]}
                  aria-current={esActual(s.href) ? "page" : undefined}
                >
                  {s.icono && (
                    <span class="menu-panel-icono" aria-hidden="true">
                      {s.icono}
                    </span>
                  )}
                  <span>
                    <span class="menu-panel-titulo">{s.texto}</span>
                    {s.descripcion && (
                      <span class="menu-panel-descripcion">{s.descripcion}</span>
                    )}
                  </span>
                </a>
              ))}
            </div>
          </div>
        ))
      }
    </header>

    <script>
      {/* Cerrar los mega-menús al pulsar fuera. Los <details> nativos no se
          cierran solos al hacer clic en otro sitio: una vez abiertos a
          golpe de clic (no de hover), se quedaban tapando el contenido de
          la página hasta que alguien volvía a pulsar la flechita. */}
      document.addEventListener("click", (e) => {
        document.querySelectorAll(".menu-item-desplegable details[open]").forEach((d) => {
          if (!d.parentElement?.contains(e.target)) d.removeAttribute("open");
        });
      });
    </script>

    <main id="contenido">
      <div class="contenedor">
        <slot />
      </div>
    </main>

    <footer class="pie">
      <div class="contenedor">
        <p class="pie-lema">{MARCA.lema}</p>
        <p><strong>Esto no es un canal oficial.</strong></p>
        <p>
          Somos una iniciativa ciudadana independiente. No gestionamos ayudas y
          no recaudamos dinero. Organizamos información pública y te enviamos al
          canal oficial que corresponde. Ante una emergencia, llama siempre al
          número de emergencias de tu país.
        </p>
        <p>
          <a href="/sobre">Quién está detrás de esto</a> ·{" "}
          <a href="/privacidad">Privacidad</a>
        </p>
        <p>Última actualización: {formatearFecha(ACTUALIZADO)}.</p>
      </div>
    </footer>
  </body>
</html>
